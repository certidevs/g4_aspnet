@model G4AspNet.Models.Category

@{
    // Determinamos si es una operación de Crear o Editar basándonos en el ID
    bool esEdicion = Model != null && Model.Id > 0;
    ViewData["Title"] = esEdicion ? "Editar Categoría" : "Nueva Categoría";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <!-- Tarjeta contenedora del formulario -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi @(esEdicion ? "bi-pencil-square" : "bi-plus-circle")"></i> 
                        @ViewData["Title"]
                    </h4>
                </div>
                
                <div class="card-body">
                    <!-- Formulario único que apunta a la acción Guardar (o Crear/Editar según tu controlador) -->
                    <form asp-action="Guardar" method="post">
                        
                        <!-- Resumen general de errores de validación del modelo -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Campo oculto para el ID en caso de Edición -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Campo: Nombre de la Categoría -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Ej. Soporte Técnico" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Campo: Descripción -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Breve descripción de la categoría..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Campo Relación: Select para entidad relacionada (Ej. Departamento o Area) -->
                   

                        <!-- Campo Enum: Select generado automáticamente desde el Enum con [Display] -->
                  

                        <!-- Botones de Acción -->
                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg"></i> @(esEdicion ? "Actualizar" : "Guardar")
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Sección de Scripts requerida para validaciones del lado del cliente (Unobtrusive validation) -->
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
@model IEnumerable<G4AspNet.Models.Ticket>

@{
    // Definimos el título de la vista que se mostrará en el navegador o Layout
    ViewData["Title"] = "Listado de Registros";
}

<!-- Contenedor principal con márgenes y diseño responsivo -->
<div class="container mt-4">
    
    <!-- Fila para la cabecera de la vista (Título y Botón Nuevo) -->
    <div class="row mb-3">
        <div class="col-md-6">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col-md-6 text-end">
            <!-- Botón "Nuevo Registro": Utiliza Tag Helpers de ASP.NET Core (asp-action) -->
            <a asp-action="Crear" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> Nuevo Registro
            </a>
        </div>
    </div>

    <!-- Tarjeta (Card) de Bootstrap para dar un efecto de contenedor elevado -->
    <div class="card shadow-sm">
        <div class="card-body">
            
            <!-- Contenedor para hacer la tabla adaptable a dispositivos móviles (scroll horizontal) -->
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    
                    <!-- Cabecera de la tabla -->
                    <thead class="table-dark">
                        <tr>
                            <!-- Usamos DisplayNameFor para obtener automáticamente el nombre de las propiedades desde el modelo -->
                            <th>@Html.DisplayNameFor(model => model.Id)</th>
                            <th>@Html.DisplayNameFor(model => model.Title)</th>
                            <th>@Html.DisplayNameFor(model => model.Description)</th>
                            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    
                    <!-- Cuerpo de la tabla -->
                    <tbody>
                        <!-- Verificamos si el modelo no es nulo y contiene elementos -->
                        @if (Model != null && Model.Any())
                        {
                            <!-- Iteramos sobre cada elemento de la colección -->
                            foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Mostramos el valor de cada propiedad usando DisplayFor -->
                                    <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                                    <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                                    
                                    <!-- Columna de Botones de Acción -->
                                    <td class="text-center">
                                        <div class="btn-group" role="group" aria-label="Acciones">
                                            
                                            <!-- Botón VER: Envía el ID del elemento actual a la acción "Detalles" -->
                                            <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white" title="Ver">
                                                <i class="bi bi-eye"></i> Ver
                                            </a>
                                            
                                            <!-- Botón EDITAR: Envía el ID del elemento actual a la acción "Editar" -->
                                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm text-white" title="Editar">
                                                <i class="bi bi-pencil"></i> Editar
                                            </a>
                                            
                                            <!-- Botón ELIMINAR: Envía el ID del elemento actual a la acción "Eliminar" -->
                                            <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Eliminar">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </a>
                                            
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- Mensaje alternativo si la lista está vacía -->
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No se encontraron registros disponibles.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Sección de Scripts para cargar dependencias adicionales como Bootstrap Icons -->
@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
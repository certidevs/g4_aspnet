@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
    ViewData["Heading"] = "Iniciar sesión";
}

@if (Model.ShowLoggedOutMessage)
{
    <div class="alert alert-info">La sesión se ha cerrado correctamente.</div>
}
<form method="post">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
    <button class="btn btn-primary w-100" type="submit">Entrar</button>
</form>
<p class="small text-secondary mt-3 mb-0">¿No tienes cuenta? <a asp-action="Register">Regístrate</a>.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!ViewData.ModelState.IsValid)
    {
        <script>Swal.fire('No se pudo iniciar sesión', 'El usuario o la contraseña no son válidos.', 'error');</script>
    }
}

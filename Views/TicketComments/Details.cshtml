@model TicketComment
@{
    ViewData["Title"] = "Detalle de comentario";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Comentario #@Model.Id</h1>
    <div class="d-flex gap-2">

        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar este comentario?')">
                <button class="btn btn-outline-danger" type="submit">Eliminar</button>
            </form>

    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ticket</dt>
            <dd class="col-sm-9"><a asp-controller="Tickets" asp-action="Details" asp-route-id="@Model.TicketId">@Model.Ticket.Title</a></dd>
            <dt class="col-sm-3">Autor</dt><dd class="col-sm-9">@(Model.Author.DisplayName ?? Model.Author.UserName)</dd>
            <dt class="col-sm-3">Mensaje</dt><dd class="col-sm-9">@Model.Message</dd>
            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9"><span class="badge @(Model.IsInternal ? "text-bg-warning" : "text-bg-secondary")">@(Model.IsInternal ? "Interno" : "Público")</span></dd>
            <dt class="col-sm-3">Fecha</dt><dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent"><a class="btn btn-outline-secondary" asp-action="Index">Volver a comentarios</a></div>
</div>

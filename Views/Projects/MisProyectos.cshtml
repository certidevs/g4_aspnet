
@model IEnumerable<G4AspNet.Models.Project>

@{
    ViewData["Title"] = "Mis proyectos";
}

<div class="container-fluid">

    <div class="mb-4">
        <h1 class="h2 fw-bold">
            <i class="bi bi-folder2-open me-2"></i>Mis proyectos
        </h1>
        <p class="text-secondary">
            Consulta los proyectos que tienes asignados como jefe de equipo.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No tienes ningún proyecto asignado actualmente.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var project in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h2 class="h5 fw-bold">
                                    @project.Name
                                </h2>

                                @if (project.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </div>

                            <p class="text-secondary">
                                @(string.IsNullOrWhiteSpace(project.Description)
                                    ? "Sin descripción."
                                    : project.Description)
                            </p>

                            <hr />

                            <p class="mb-2">
                                <i class="bi bi-building me-2"></i>
                                <strong>Empresa:</strong>
                                @project.Company.Name
                            </p>

                            <p class="mb-0">
                                <i class="bi bi-clock me-2"></i>
                                <strong>Tiempo de respuesta:</strong>
                                @project.ResponseTimeHours horas
                            </p>

                        </div>

                    </div>
                </div>
            }

        </div>
    }

</div>

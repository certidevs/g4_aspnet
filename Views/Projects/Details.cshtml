@model Project
@{
    ViewData["Title"] = "Detalle de proyecto";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@Model.Name</h1>
    <div class="d-flex gap-2">
        @* DESCOMENTA: <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> *@
        @* DESCOMENTA: <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar este proyecto?')"><button class="btn btn-outline-danger" type="submit">Eliminar</button></form> *@
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">Empresa</dt>
            <dd class="col-sm-9"><a asp-controller="Companies" asp-action="Details" asp-route-id="@Model.CompanyId">@Model.Company.Name</a></dd>
            <dt class="col-sm-3">Nivel de soporte</dt><dd class="col-sm-9">@Html.DisplayFor(model => model.SupportLevel)</dd>
            <dt class="col-sm-3">Tiempo de respuesta</dt><dd class="col-sm-9">@Model.ResponseTimeHours horas</dd>
            <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.IsActive ? "Activo" : "Inactivo")</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent"><a class="btn btn-outline-secondary" asp-action="Index">Volver a proyectos</a></div>
</div>

<h2 class="h4">Tickets del proyecto</h2>
@if (!Model.Tickets.Any())
{
    <div class="alert alert-info">Este proyecto no tiene tickets.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Título</th><th>Estado</th><th>Prioridad</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model.Tickets.OrderByDescending(t => t.CreatedAt))
                {
                    <tr>
                        <td class="fw-semibold">@ticket.Title</td>
                        <td>@Html.DisplayFor(modelItem => ticket.Status)</td>
                        <td>@Html.DisplayFor(modelItem => ticket.Priority)</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">Ver</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@model IEnumerable<Ticket>
@{
    ViewData["Title"] = "Tickets";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tables.css" asp-append-version="true" />
}

<div class="table-panel">
    <div class="table-panel-header">
        <h1 class="table-panel-title" id="tickets-heading">Tickets</h1>
        @if (!User.IsInRole(RoleNames.Technician))
        {
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nuevo ticket</a>
        }
        <form asp-action="Index" method="get" class="table-search" role="search" id="ticket-filter-form">
            <button class="table-search-action" type="submit" aria-label="Buscar tickets" title="Buscar tickets">
                <i class="bi bi-search" aria-hidden="true"></i>
            </button>
            <input class="table-search-input" type="search" name="search" value="@ViewBag.Search"
                   placeholder="Buscar ticket…" aria-label="Buscar por título, descripción o proyecto" />
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a class="table-search-action table-search-clear" asp-action="Index" aria-label="Limpiar búsqueda" title="Limpiar búsqueda">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </a>
            }
        </form>
    </div>

    @if (User.IsInRole(RoleNames.Admin))
    {
        <div class="d-flex flex-wrap align-items-end gap-2 px-2 pb-3">
            <div>
                <label class="form-label small mb-1" for="f-status">Estado</label>
                <select id="f-status" name="status" form="ticket-filter-form" class="form-select form-select-sm" onchange="this.form.submit()"
                        asp-items="Html.GetEnumSelectList<TicketStatus>().Select(i => new SelectListItem(i.Text, i.Value, i.Value == ((int?)ViewBag.Status)?.ToString()))">
                    <option value="">Todos</option>
                </select>
            </div>
            <div>
                <label class="form-label small mb-1" for="f-priority">Prioridad</label>
                <select id="f-priority" name="priority" form="ticket-filter-form" class="form-select form-select-sm" onchange="this.form.submit()"
                        asp-items="Html.GetEnumSelectList<TicketPriority>().Select(i => new SelectListItem(i.Text, i.Value, i.Value == ((int?)ViewBag.Priority)?.ToString()))">
                    <option value="">Todas</option>
                </select>
            </div>
            <div>
                <label class="form-label small mb-1" for="f-company">Empresa</label>
                <select id="f-company" name="companyId" form="ticket-filter-form" class="form-select form-select-sm" onchange="this.form.submit()"
                        asp-items="(SelectList)ViewBag.Companies">
                    <option value="">Todas</option>
                </select>
            </div>
            <div>
                <label class="form-label small mb-1" for="f-project">Proyecto</label>
                <select id="f-project" name="projectId" form="ticket-filter-form" class="form-select form-select-sm" onchange="this.form.submit()"
                        asp-items="(SelectList)ViewBag.Projects">
                    <option value="">Todos</option>
                </select>
            </div>
            <div>
                <label class="form-label small mb-1" for="f-category">Categoría</label>
                <select id="f-category" name="categoryId" form="ticket-filter-form" class="form-select form-select-sm" onchange="this.form.submit()"
                        asp-items="(SelectList)ViewBag.Categories">
                    <option value="">Todas</option>
                </select>
            </div>
            <div>
                <label class="form-label small mb-1" for="f-from">Desde</label>
                <input id="f-from" type="date" name="from" form="ticket-filter-form" class="form-control form-control-sm"
                       value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" onchange="this.form.submit()" />
            </div>
            <div>
                <label class="form-label small mb-1" for="f-to">Hasta</label>
                <input id="f-to" type="date" name="to" form="ticket-filter-form" class="form-control form-control-sm"
                       value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" onchange="this.form.submit()" />
            </div>
            @if ((ViewBag.HasFilters as bool?) == true)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-search="@ViewBag.Search">
                    <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Quitar filtros
                </a>
            }
        </div>
    }

    @if (!Model.Any())
    {
        <div class="table-panel-empty">
            <i class="bi bi-ticket-perforated fs-2" aria-hidden="true"></i>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <p class="mt-2 mb-0">No se encontraron tickets para "@ViewBag.Search".</p>
            }
            else
            {
                <p class="mt-2 mb-0">No hay tickets para mostrar.</p>
            }
        </div>
    }
    else
    {
        <div class="app-table-scroll" role="region" aria-labelledby="tickets-heading" tabindex="0">
            <table class="app-table app-table-wide">
                <thead>
                    <tr>
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <th scope="col"></th>
                        }
                        <th class="app-table-primary-column" scope="col">Incidencia</th>
                        <th scope="col">Proyecto</th>
                        <th scope="col">Prioridad</th>
                        <th scope="col">Estado</th>
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <th scope="col">Empresa</th>
                            <th scope="col">Creado por</th>
                            <th scope="col">Técnico</th>
                            <th scope="col">Creado</th>
                        }
                        <th scope="col"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        var priorityClass = ticket.Priority switch
                        {
                            TicketPriority.Medium => "table-label-sage",
                            TicketPriority.High => "table-label-blue",
                            TicketPriority.Urgent => "table-label-teal",
                            _ => ""
                        };
                        var statusClass = ticket.Status switch
                        {
                            TicketStatus.Open => "table-label-blue",
                            TicketStatus.InProgress => "table-label-sage",
                            TicketStatus.WaitingCustomer => "table-label-sand",
                            TicketStatus.Resolved => "table-label-teal",
                            _ => ""
                        };
                        <tr>
                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <td>#@ticket.Id</td>
                            }
                            <th scope="row"><a asp-action="Details" asp-route-id="@ticket.Id">@ticket.Title</a></th>
                            <td>@ticket.Project.Name</td>
                            <td><span class="table-label @priorityClass">@Html.DisplayFor(modelItem => ticket.Priority)</span></td>
                            <td><span class="table-label @statusClass">@Html.DisplayFor(modelItem => ticket.Status)</span></td>
                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <td>@ticket.Project.Company.Name</td>
                                <td>@(ticket.CreatedBy.DisplayName ?? ticket.CreatedBy.UserName)</td>
                                <td>@(ticket.AssignedTo?.DisplayName ?? ticket.AssignedTo?.UserName ?? "Sin asignar")</td>
                                <td>@ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            }
                            <td>
                                <div class="table-row-actions">
                                    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Technician))
                                    {
                                    <a class="table-row-action" asp-action="Edit" asp-route-id="@ticket.Id" title="Editar" aria-label="Editar ticket">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    }
                                    @if (User.IsInRole(RoleNames.Admin))
                                    {
                                        <form asp-action="Delete" asp-route-id="@ticket.Id" method="post" onsubmit="return confirm('¿Eliminar este ticket?')">
                                            <button class="table-row-action table-row-action-delete" type="submit" title="Eliminar" aria-label="Eliminar ticket">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

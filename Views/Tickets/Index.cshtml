@model IEnumerable<Ticket>
@{
    ViewData["Title"] = "Tickets";
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <h1 class="h2 mb-0">Tickets</h1>
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Nuevo ticket</a>
            @* TODO (issue #17, más adelante): buscador y filtros por estado y prioridad *@
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-secondary py-5">
                <i class="bi bi-ticket-perforated display-4"></i>
                <p class="mt-2 mb-0">Todavía no hay tickets.</p>
            </div>
        }
        else
        {
            <div class="table-responsive rounded">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="bg-info-subtle">Incidencia</th>
                            <th class="bg-info-subtle">Proyecto</th>
                            <th class="bg-info-subtle">Prioridad</th>
                            <th class="bg-info-subtle">Estado</th>
                            <th class="bg-info-subtle"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model)
                        {
                            var priorityClass = ticket.Priority switch
                            {
                                TicketPriority.Urgent => "text-bg-primary",
                                TicketPriority.High => "text-bg-secondary",
                                _ => "text-bg-info"
                            };
                            var statusClass = ticket.Status switch
                            {
                                TicketStatus.Open => "text-bg-secondary",
                                TicketStatus.Resolved or TicketStatus.Closed => "text-bg-primary",
                                _ => "text-bg-info"
                            };
                            <tr>
                                <td><a asp-action="Details" asp-route-id="@ticket.Id">@ticket.Title</a></td>
                                <td>@ticket.Project.Name</td>
                                <td><span class="badge @priorityClass">@Html.DisplayFor(modelItem => ticket.Priority)</span></td>
                                <td><span class="badge @statusClass">@Html.DisplayFor(modelItem => ticket.Status)</span></td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@ticket.Id" title="Editar" aria-label="Editar"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@ticket.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este ticket?')"><button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar" aria-label="Eliminar"><i class="bi bi-trash"></i></button></form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

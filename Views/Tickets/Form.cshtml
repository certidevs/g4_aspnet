@model Ticket
@{
    ViewData["Title"] = "Formulario de ticket";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Formulario de ticket</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</div>

<div class="alert alert-warning">TODO (issue #17): descomenta el formulario y ajústalo</div>

@* Modelo a copiar: Views/Companies/Form.cshtml (ejemplo completo). Al terminar, borra el aviso amarillo de arriba. *@

<form asp-action="Save" method="post" class="card">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @* Id oculto: 0 = ticket nuevo, otro valor = edición. Así Save sabe qué hacer *@
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label">Título</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ProjectId" class="form-label">Proyecto</label>
                <select asp-for="ProjectId" asp-items="(SelectList)ViewBag.Projects" class="form-select"></select>
                <span asp-validation-for="ProjectId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label">Categoría</label>
                <select asp-for="CategoryId" asp-items="(SelectList)ViewBag.Categories" class="form-select"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Priority" class="form-label">Prioridad</label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TicketPriority>()" class="form-select"></select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AssignedToId" class="form-label">Técnico asignado</label>
                <select asp-for="AssignedToId" asp-items="(SelectList)ViewBag.Technicians" class="form-select">
                    <option value="">Sin asignar</option>
                </select>
                <span asp-validation-for="AssignedToId" class="text-danger"></span>
            </div>
            @* El estado solo se edita en tickets existentes: al crear siempre empieza en Open *@
            @if (Model.Id != 0)
            {
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label">Estado</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<TicketStatus>()" class="form-select"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            }
        </div>
    </div>
    <div class="card-footer bg-transparent text-end">
        <button class="btn btn-primary" type="submit">@(Model.Id == 0 ? "Crear ticket" : "Guardar cambios")</button>
    </div>
</form>

@* Validación en el navegador (jQuery Validation) además de la del servidor con ModelState.IsValid *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


@model Company
@{
    ViewData["Title"] = "Detalle de empresa";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@Model.Name</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar esta empresa?')">
            <button class="btn btn-outline-danger" type="submit">Eliminar</button>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">CIF</dt><dd class="col-sm-9">@Model.TaxId</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@Model.Phone</dd>
            <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.IsActive ? "Activa" : "Inactiva")</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent"><a class="btn btn-outline-secondary" asp-action="Index">Volver a empresas</a></div>
</div>

<h2 class="h4">Proyectos</h2>
@if (!Model.Projects.Any())
{
    <div class="alert alert-info">Esta empresa no tiene proyectos.</div>
}
else
{
    <div class="table-responsive border rounded mb-4">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Proyecto</th><th>Nivel de soporte</th><th>Tiempo de respuesta</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var project in Model.Projects)
                {
                    <tr>
                        <td class="fw-semibold">@project.Name</td>
                        <td>@Html.DisplayFor(modelItem => project.SupportLevel)</td>
                        <td>@project.ResponseTimeHours h</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id">Ver</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Usuarios</h2>
@if (!Model.Users.Any())
{
    <div class="alert alert-info">Esta empresa no tiene usuarios.</div>
}
else
{
    <ul class="list-group">
        @foreach (var user in Model.Users)
        {
            <li class="list-group-item">
                <span class="fw-semibold">@(user.DisplayName ?? user.UserName)</span>
                <span class="text-secondary">· @user.Email</span>
            </li>
        }
    </ul>
}

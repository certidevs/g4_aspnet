@inject UserManager<ApplicationUser> UserManager
@inject ImageStorage ImageStorage
@{
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
    var currentName = currentUser?.DisplayName ?? User.Identity?.Name ?? "Usuario";
    var initial = string.IsNullOrWhiteSpace(currentName) ? "U" : currentName[..1].ToUpperInvariant();
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavClass(string controller) => string.Equals(activeController, controller, StringComparison.OrdinalIgnoreCase)
        ? "nav-link active"
        : "nav-link";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? "ZolveSolutions" : $"{ViewData["Title"]} · ZolveSolutions")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell d-flex flex-column flex-lg-row">
        <aside class="sidebar d-flex flex-column p-3">
            <div class="d-flex justify-content-between align-items-center">
                <a class="sidebar-brand d-block flex-grow-1 text-center mb-lg-3" asp-controller="Home" asp-action="Index">
                    <img class="rounded d-block mx-auto" src="~/logo/logoHelpDesk%20.webp" alt="ZolveSolutions" height="56" />
                    <span class="d-block fs-3 fw-semibold text-white lh-1 mt-0">Zolve Solutions</span>
                </a>
                <button class="btn btn-outline-light btn-sm d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar navegación">
                    <i class="bi bi-list"></i>
                </button>
            </div>
            <div class="collapse d-lg-flex flex-column flex-grow-1" id="mainNav">
                <hr class="sidebar-divider d-none d-lg-block" />
                <ul class="nav flex-column gap-1 mb-auto">
                    <li class="nav-item"><a class='@NavClass("Home")' asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i>Inicio</a></li>
                    <li class="nav-item"><a class='@NavClass("Tickets")' asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-perforated"></i>Tickets</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class='@NavClass("TicketComments")' asp-controller="TicketComments" asp-action="Index"><i class="bi bi-chat-left-text"></i>Comentarios</a></li>
                    }
                    <li class="nav-item"><a class='@NavClass("Projects")' asp-controller="Projects" asp-action="Index"><i class="bi bi-folder"></i>Proyectos</a></li>
                    <li class="nav-item"><a class='@NavClass("Companies")' asp-controller="Companies" asp-action="Index"><i class="bi bi-building"></i>Empresas</a></li>
                    <li class="nav-item"><a class='@NavClass("Categories")' asp-controller="Categories" asp-action="Index"><i class="bi bi-layers"></i>Categorías</a></li>
                    @if (User.IsInRole(RoleNames.Admin))
                    {
                        <li class="nav-item"><a class='@NavClass("Users")' asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i>Usuarios</a></li>
                    }
                </ul>
                <hr class="sidebar-divider" />
                @if (currentUser is not null)
                {
                    <div class="dropdown dropup">
                        <a class="sidebar-user dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (ImageStorage.GetUrl(currentUser.AvatarFileName) is string avatarUrl)
                            {
                                <img class="avatar" src="@avatarUrl" alt="Avatar de @currentName" />
                            }
                            else
                            {
                                <span class="avatar avatar-placeholder">@initial</span>
                            }
                            <span class="small">@currentName</span>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Edit"><i class="bi bi-pencil me-2"></i>Editar perfil</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-grid gap-2">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión</a>
                        <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Register">Crear cuenta</a>
                    </div>
                }
            </div>
        </aside>

        <div class="app-content d-flex flex-column flex-grow-1">
            <main class="container-fluid px-lg-4 py-4 flex-grow-1">
                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @message
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="border-top py-3 px-lg-4 text-secondary small">
                <div class="container-fluid">ZolveSolutions · G4 ASP.NET · .NET 10 · EF Core · SQLite</div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
